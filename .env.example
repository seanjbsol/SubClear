# Copy to apps/api or export in your shell. Never commit real secrets.
# Jwt__Key=generate-a-32-character-plus-random-string-for-production
# Database__Provider=Sqlite
# Database__ConnectionString=Data Source=subclear.dev.db

# SQL Server (production / staging)
# Database__Provider=SqlServer
# Database__ConnectionString=Server=localhost,1433;Database=SubClear;User Id=sa;Password=;TrustServerCertificate=True;Encrypt=True

# Mobile
# EXPO_PUBLIC_API_URL=http://localhost:5151

# QckApp Subscription API (never commit real keys)
# SubscriptionApi__UseStub=true
# SubscriptionApi__ProductCode=SubClear
# SubscriptionApi__BaseUrl=https://subscriptions.qckapp.example
# SubscriptionApi__ApiKey=
# SubscriptionApi__AppBaseUrl=https://app.subclear.example

# Email (Console or File if SMTP is not configured)
# Email__Provider=Console
# Email__FileDirectory=emails
# Email__SmtpHost=
# Email__SmtpPort=587
# Email__SmtpUser=
# Email__SmtpPassword=
# Email__FromAddress=notices@subclear.uk

# Subcontractor portal links
# Portal__PublicBaseUrl=https://app.subclear.example
# Portal__TokenLifetimeHours=168

# Automated chases (Pro). Background job is off unless enabled.
# Chase__BackgroundEnabled=false
# Chase__DefaultCadenceDays=7
